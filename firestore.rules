rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'ACTIVE';
    }

    match /users/{uid} {
      allow read: if owner(uid) || admin();
      allow create: if owner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role == 'USER'
        && request.resource.data.status == 'ACTIVE';
      allow update: if admin()
        && request.resource.data.uid == resource.data.uid;
      allow update: if owner(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email', 'displayName', 'photoURL', 'provider', 'lastLogin',
          'updatedAt', 'favoriteCount', 'bookmarkCount', 'searchCount',
          'totalSearches', 'lastSearch'
        ]);
      allow delete: if admin();

      match /bookmarks/{id} {
        allow read, write: if owner(uid) || admin();
      }
      match /favorite_journals/{id} {
        allow read, write: if owner(uid) || admin();
      }
      match /favorites/{id} {
        allow read, write: if owner(uid) || admin();
      }
      match /collections/{id} {
        allow read, write: if owner(uid) || admin();
      }
      match /collection_items/{id} {
        allow read, write: if owner(uid) || admin();
      }
      match /search_history/{id} {
        allow read, write: if owner(uid) || admin();
      }
      match /activity_logs/{id} {
        allow read: if owner(uid) || admin();
        allow create: if owner(uid) || admin();
        allow update, delete: if admin();
      }
      match /settings/{id} {
        allow read: if owner(uid) || admin();
        allow create, update: if (owner(uid) || admin())
          && request.resource.data.keys().hasOnly([
            'darkMode', 'language', 'notifications',
            'notificationEnabled', 'recommendationEnabled', 'theme'
          ]);
        allow delete: if admin();
      }
    }

    match /notifications/{id} {
      allow read: if signedIn()
        && resource.data.isActive == true
        && (resource.data.targetRole == null
          || resource.data.targetRole == 'USER'
          || (resource.data.targetRole == 'ADMIN' && admin()));
      allow write: if admin();
    }

    match /feedback/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if admin();
    }

    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if admin();
    }

    match /app_config/{id} {
      allow read: if signedIn();
      allow write: if admin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
